# =============== #
# Unity 6 .gitignore #
# =============== #

# --- Unity Generated Folders ---
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Aa]rtifacts/
[Mm]emory[Cc]aptures/
[Rr]ecordings/
[Bb]urst[Cc]ache/

# --- Asset Store & Packages ---
# Only ignore these if you aren't using them for the project
[Aa]ssets/AssetStoreTools*
/Assets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# --- OS Specific ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE & User Settings ---
# These cause massive merge conflicts if shared between teammates
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.pdb
*.mdb
*.opendb
*.VC.db
.idea/
.vscode/
.vs/
*.sln.iml

# --- Android / Gradle / Java ---
.gradle/
gradle/
*.apk
*.aab
*.unitypackage
*.keystore
!debug.keystore # Usually keep the debug key so teammates can build immediately

# --- Crash Reports ---
sysinfo.txt
*.stacktrace
